{
  "version": "2.0.0",
  "tasks": [
    // ── Simulator ────────────────────────────────────────────────────────────
    {
      "label": "Sim: Start telemetry simulator",
      "type": "shell",
      "command": "firmware/sim/.venv/bin/python",
      "args": ["firmware/sim/simulate_telemetry.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "sim",
        "tabName": "Telemetry Simulator"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Sim: Start simulator (custom broker)",
      "type": "shell",
      "command": "firmware/sim/.venv/bin/python",
      "args": [
        "firmware/sim/simulate_telemetry.py",
        "--host", "${input:brokerHost}",
        "--prefix", "${input:topicPrefix}",
        "--hz", "${input:updateHz}"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "sim",
        "tabName": "Telemetry Simulator"
      },
      "group": "test",
      "problemMatcher": []
    },

    // ── Dashboard ────────────────────────────────────────────────────────────
    {
      "label": "Dashboard: Serve on http://localhost:8080",
      "type": "shell",
      "command": "firmware/sim/.venv/bin/python",
      "args": ["-m", "http.server", "8080", "--directory", "firmware/display_node"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "sim",
        "tabName": "Dashboard Server"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Serving HTTP",
          "endsPattern": "Serving HTTP"
        }
      }
    },
    {
      "label": "Dashboard: Open in browser",
      "type": "shell",
      "command": "xdg-open",
      "args": ["http://localhost:8080/dashboard.html"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "silent", "panel": "shared" },
      "problemMatcher": []
    },

    // ── Mosquitto (system service on this machine) ──────────────────────────
    {
      "label": "Broker: Restart system Mosquitto",
      "type": "shell",
      // The system Mosquitto (apt-installed) runs as a service and loads
      // /etc/mosquitto/conf.d/websockets.conf for the WebSocket listener.
      // Use this task after changes to that file, or if the broker stops.
      "command": "sudo systemctl restart mosquitto && echo 'Mosquitto restarted'",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared", "tabName": "Broker" },
      "problemMatcher": []
    },
    {
      "label": "Broker: Monitor all MQTT topics",
      "type": "shell",
      "command": "mosquitto_sub",
      "args": ["-h", "127.0.0.1", "-t", "#", "-v"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "broker",
        "tabName": "MQTT Monitor"
      },
      "problemMatcher": []
    },

    // ── Combined ─────────────────────────────────────────────────────────────
    {
      "label": "Dev: Full local stack (broker + simulator + dashboard)",
      "dependsOn": [
        "Sim: Start telemetry simulator",
        "Dashboard: Serve on http://localhost:8080",
        "Dashboard: Open in browser"
      ],
      "dependsOrder": "sequence",
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },

    // ── Venv management ──────────────────────────────────────────────────────
    {
      "label": "Sim: Install / update Python dependencies",
      "type": "shell",
      "command": "firmware/sim/.venv/bin/pip install -r firmware/sim/requirements.txt",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    }
  ],

  "inputs": [
    {
      "id": "brokerHost",
      "type": "promptString",
      "description": "MQTT broker hostname or IP",
      "default": "192.168.8.1"
    },
    {
      "id": "topicPrefix",
      "type": "promptString",
      "description": "MQTT topic prefix",
      "default": "vehicle"
    },
    {
      "id": "updateHz",
      "type": "promptString",
      "description": "Publish rate (Hz)",
      "default": "10"
    }
  ]
}
